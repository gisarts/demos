---
import { contact } from '../data/site';
interface Props {
  title?: string;
  text?: string;
  buttonLabel?: string;
  buttonHref?: string;
}
const {
  title = 'Klaar om aan de slag te gaan?',
  text = 'Ontdek hoe Cook uw organisatie helpt om geografische data slimmer te raadplegen, registreren en analyseren.',
  buttonLabel = 'Demo aanvragen',
  buttonHref = contact.demoRequest,
} = Astro.props;
---

<section class="bg-gradient-to-b from-gold-strong to-gold py-16">
  <div class="container-x text-center">
    <h2 class="mx-auto max-w-2xl text-3xl font-bold text-white sm:text-4xl">{title}</h2>
    <p class="mx-auto mt-4 max-w-xl text-lg text-white/85">{text}</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href={buttonHref} class="btn btn-white px-8">{buttonLabel}</a>
      <a href="/demo" class="btn btn-ink px-8">Bekijk de live demo</a>
    </div>
  </div>
</section>
