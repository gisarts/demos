---
interface Item {
  q: string;
  a: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.a },
  })),
};
---

<div class="mx-auto max-w-3xl space-y-3">
  {
    items.map((item) => (
      <details
        name="faq"
        class="group rounded-2xl border border-black/5 bg-white shadow-soft transition-shadow open:shadow-card"
      >
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-2xl px-6 py-5 text-lg font-medium text-ink [&::-webkit-details-marker]:hidden">
          {item.q}
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-cream text-gold transition-transform duration-300 group-open:rotate-45">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
          </span>
        </summary>
        <p class="px-6 pb-6 text-[15px] leading-relaxed text-muted">{item.a}</p>
      </details>
    ))
  }
</div>

<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
