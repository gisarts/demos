---
import Icon from './Icon.astro';
import { contact, site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="bg-ink text-white/80">
  <div class="container-x grid gap-10 py-14 md:grid-cols-3">
    <!-- Brand -->
    <div>
      <a href={contact.gisarts} target="_blank" rel="noopener" class="inline-block">
        <img
          src="/img/logo_gisarts.webp"
          alt="Gisarts logo"
          class="h-12 w-auto brightness-0 invert"
          loading="lazy"
        />
      </a>
      <div class="mt-6 inline-flex items-center gap-2 rounded-lg bg-white/5 px-3 py-2">
        <img
          src="/img/iso-dekra.webp"
          alt="ISO 27001 DEKRA gecertificeerd"
          title="ISO 27001 gecertificeerd"
          class="h-12 w-auto"
          loading="lazy"
        />
        <span class="text-sm text-white/60">ISO 27001<br />gecertificeerd</span>
      </div>
    </div>

    <!-- About -->
    <div>
      <h3 class="text-lg font-bold text-white">Over Cook</h3>
      <p class="mt-3 text-[15px] leading-relaxed text-white/70">
        De {site.name} GIS-Viewer is ontwikkeld met focus op veiligheid,
        compleetheid en personalisatie, voor de beste ervaring met uw GIS-data.
      </p>
      <a
        href="/releases"
        class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-gold-tint hover:text-white"
      >
        <Icon name="arrow" size={16} />
        Release Notes & Roadmap
      </a>
    </div>

    <!-- Contact -->
    <div>
      <h3 class="text-lg font-bold text-white">Contact</h3>
      <ul class="mt-3 space-y-3 text-[15px]">
        <li class="flex items-start gap-3">
          <Icon name="mail" size={18} class="mt-0.5 shrink-0 text-gold-tint" />
          <a href={`mailto:${contact.email}`} class="hover:text-white">{contact.email}</a>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="phone" size={18} class="mt-0.5 shrink-0 text-gold-tint" />
          <a href={contact.phoneHref} class="hover:text-white">{contact.phoneDisplay}</a>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="pin" size={18} class="mt-0.5 shrink-0 text-gold-tint" />
          <a href={contact.mapsUrl} target="_blank" rel="noopener" class="hover:text-white">
            {contact.address}<br />{contact.addressLine2}
          </a>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="lock" size={18} class="mt-0.5 shrink-0 text-gold-tint" />
          <a href={contact.privacy} target="_blank" rel="noopener" class="hover:text-white">
            Privacyverklaring
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-x flex flex-col items-center justify-between gap-2 py-5 text-center text-sm text-white/55 sm:flex-row sm:text-left">
      <p>
        © {year} {site.name}, onderdeel van
        <a href={contact.gisarts} target="_blank" rel="noopener" class="link-underline text-white/80">Gisarts.nl</a>
      </p>
      <a
        href="/algemene-voorwaarden-gisarts.pdf"
        target="_blank"
        rel="noopener"
        class="link-underline text-white/80"
      >
        Algemene voorwaarden
      </a>
    </div>
  </div>
</footer>
