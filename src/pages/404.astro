---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pagina niet gevonden | Cook">
  <section class="flex min-h-[60vh] items-center py-20">
    <div class="container-x text-center">
      <p class="text-7xl font-black text-gold">404</p>
      <h1 class="mt-4 text-3xl font-light text-ink">Deze pagina bestaat niet</h1>
      <p class="mx-auto mt-3 max-w-md text-lg text-muted">
        De pagina die u zoekt is verplaatst of bestaat niet meer.
      </p>
      <a href="/" class="btn btn-gold mt-8 px-8">Terug naar home</a>
    </div>
  </section>
</Layout>
