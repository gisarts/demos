---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { viewers } from '../data/viewers';
import { site } from '../data/site';

const featured = viewers.find((v) => v.featured) ?? viewers[0];
---

<Layout
  title="Live Demo | Cook GIS-Viewer"
  description="Probeer de GIS-Viewer van Cook. Bekijk live voorbeelden en open elke viewer in volledig scherm."
>
  <Hero
    compact
    eyebrow="Probeer het zelf"
    title="Probeer de GIS-Viewer van <b>Cook</b>"
    subtitle="Bekijk hieronder een live voorbeeld en verken alle beschikbare viewers. Geen registratie nodig."
  >
    <a href="#viewers" class="btn btn-white px-8">Alle viewers</a>
    <a href={site.viewerBase} target="_blank" rel="noopener" class="btn btn-ink px-8">
      Open in volledig scherm
    </a>
  </Hero>

  <!-- Live iframe -->
  <section id="live-demo" class="scroll-mt-24 py-16">
    <div class="container-x">
      <SectionHeading
        eyebrow="Live demo"
        title="De viewer <b>in actie</b>"
        subtitle="Interactief voorbeeld van de Cook GIS-Viewer. Klik hieronder op een viewer om deze hier te laden."
      />
      <div class="mt-10 overflow-hidden rounded-2xl border border-black/5 shadow-card">
        <iframe
          id="demo-frame"
          src={featured.url}
          title={`Live demo: ${featured.title}`}
          loading="lazy"
          class="h-[60vh] min-h-[420px] w-full"
        ></iframe>
      </div>
      <p class="mt-3 flex flex-wrap items-center justify-center gap-x-2 text-center text-sm text-muted">
        Live viewer: <span id="demo-frame-title" class="font-medium text-ink">{featured.title}</span>
        <a
          id="demo-frame-fullscreen"
          href={featured.url}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1 font-medium text-gold hover:text-gold-strong"
        >
          Open in volledig scherm <Icon name="arrow" size={14} />
        </a>
      </p>
    </div>
  </section>

  <!-- Viewer grid -->
  <section id="viewers" class="scroll-mt-24 bg-cream-soft py-16">
    <div class="container-x">
      <SectionHeading
        eyebrow="Ontdek de mogelijkheden"
        title="Alle <b>viewers</b>"
        subtitle="Klik op een viewer om deze bovenaan in de interactieve viewer te laden."
      />
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          viewers.map((v) => (
            <a
              href={v.url}
              data-viewer
              data-url={v.url}
              data-title={v.title}
              target="_blank"
              rel="noopener"
              class="group flex flex-col overflow-hidden rounded-2xl border border-black/5 bg-white shadow-soft transition-all duration-300 hover:-translate-y-1.5 hover:shadow-card"
            >
              <div class="relative aspect-[16/10] overflow-hidden">
                <img
                  src={v.image}
                  alt={v.title}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <span class="absolute inset-0 bg-gold/0 transition-colors duration-300 group-hover:bg-gold/10" />
                <span class="absolute right-3 top-3 flex h-9 w-9 translate-y-1 items-center justify-center rounded-full bg-white/90 text-gold opacity-0 shadow-soft transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100">
                  <Icon name="arrow" size={18} />
                </span>
              </div>
              <div class="flex flex-1 flex-col p-5">
                <h3 class="text-lg font-bold text-ink">{v.title}</h3>
                <div class="mt-auto flex items-center justify-between pt-3">
                  <span class="text-xs uppercase tracking-wide text-muted">{v.source}</span>
                  <span class="inline-flex items-center gap-1 text-sm font-medium text-gold group-hover:text-gold-strong">
                    Bekijken <Icon name="arrow" size={15} />
                  </span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Contact strip -->
  <section class="bg-gradient-to-b from-gold-strong to-gold py-16">
    <div class="container-x grid items-center gap-8 md:grid-cols-[1.4fr_1fr]">
      <div>
        <h2 class="text-3xl font-bold text-white sm:text-4xl">Uw eigen data in Cook?</h2>
        <p class="mt-3 max-w-xl text-lg text-white/85">
          In de standaarddemo is uploaden bewust uitgeschakeld. Wilt u zien hoe
          uw eigen datasets werken binnen Cook? Wij richten graag een
          persoonlijke demonstratie voor u in.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 md:justify-end">
        <a href="https://www.gisarts.nl/contact" class="btn btn-white px-8">Neem contact op</a>
        <a href="/functies" class="btn btn-ink px-8">Bekijk functies</a>
      </div>
    </div>
  </section>

  <script>
    const frame = document.getElementById('demo-frame') as HTMLIFrameElement | null;
    const frameTitle = document.getElementById('demo-frame-title');
    const fullscreen = document.getElementById('demo-frame-fullscreen') as HTMLAnchorElement | null;
    const liveDemo = document.getElementById('live-demo');

    document.querySelectorAll<HTMLAnchorElement>('[data-viewer]').forEach((card) => {
      card.addEventListener('click', (event) => {
        // Laat gebruikers met modifier-toetsen of middenklik gewoon een nieuw tabblad openen.
        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
          return;
        }
        const url = card.dataset.url;
        const title = card.dataset.title ?? '';
        if (!url || !frame) return;

        event.preventDefault();
        if (frame.src !== url) frame.src = url;
        frame.title = `Live demo: ${title}`;
        if (frameTitle) frameTitle.textContent = title;
        if (fullscreen) fullscreen.href = url;
        liveDemo?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  </script>
</Layout>
